{
    "name": "knighttower/toolbox",
    "description": "Utilities",
    "version": "1.0.0",
    "type": "project",
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "laravel/framework": "^10|^11|^12",
        "nesbot/carbon": "^3.7.0",
        "react/async": "^4.3",
        "react/promise": "^3.2"
    },
    "authors": [
        {
            "name": "knighttower",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Knighttower\\Toolbox\\": "src"
        },
        "files": [
            "src/Helpers/ToolboxGlobal.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Knighttower\\Toolbox\\Providers\\ToolboxServiceProvider"
            ]
        }
    }
}
